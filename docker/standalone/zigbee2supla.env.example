# zigbee2supla - standalone container configuration.
# Copy to zigbee2supla.env and fill in. All options: docs/docker.md.

# --- Supla server -----------------------------------------------------------
# Supla Cloud: e.g. svr12.supla.org (see "Server" in Supla Cloud account).
# Local server (supla-docker on another machine): its IP address or name.
Z2S_SUPLA_SERVER=
Z2S_SUPLA_EMAIL=
#Z2S_SUPLA_PORT=2016

# Certificate verification:
#   0 - Supla Cloud (default)
#   3 - local server from supla-docker: pin its certificate; copy
#       ssl/server/cert.crt from the supla-docker directory of that machine
#       to ./certs/supla-server.crt
Z2S_SUPLA_SECURITY_LEVEL=0
#Z2S_SUPLA_CA_FILE=/certs/supla-server.crt

# --- MQTT broker used by zigbee2mqtt (e.g. Mosquitto add-on in HA) -----------
# Leave empty with docker-compose.zigbee2mqtt.yml (own coordinator).
Z2S_MQTT_HOST=
Z2S_MQTT_PORT=1883
Z2S_MQTT_USERNAME=
Z2S_MQTT_PASSWORD=
#Z2S_Z2M_BASE_TOPIC=zigbee2mqtt

# --- Optional ------------------------------------------------------------------
# Bridge only / never bridge these devices (IEEE or name, comma separated).
#Z2S_INCLUDE=
#Z2S_EXCLUDE=
#Z2S_LOG_LEVEL=info

# Time zone of the timestamps in the log (tz database name).
TZ=Europe/Warsaw

# --- Home Assistant: duplicates from Supla MQTT discovery -------------------
# With MQTT enabled in Supla Cloud, bridged ZigBee devices also reach Home
# Assistant through Supla MQTT discovery, duplicating zigbee2mqtt devices.
# The gateway can disable those copies in HA (docs/home-assistant.md).
# Token: HA -> profile -> Security -> Long-lived access tokens.
#Z2S_HA_DISABLE_SUPLA_DUPLICATES=true
#Z2S_HA_WEBSOCKET_URL=ws://192.168.1.10:8123/api/websocket
#Z2S_HA_TOKEN=
