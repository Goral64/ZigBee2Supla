# zigbee2supla configuration for supla-docker.
# Copy to zigbee2supla.env in the supla-docker directory and fill in.
# All options: docs/docker.md (Z2S_<OPTION>).

# E-mail of the account in your local Supla Cloud.
Z2S_SUPLA_EMAIL=

# MQTT broker used by zigbee2mqtt (e.g. Mosquitto add-on in Home Assistant).
# Leave empty with docker-compose.zigbee2mqtt.yml (own coordinator) and
# with Z2S_SOURCE=zha.
Z2S_MQTT_HOST=
Z2S_MQTT_PORT=1883
Z2S_MQTT_USERNAME=
Z2S_MQTT_PASSWORD=
#Z2S_Z2M_BASE_TOPIC=zigbee2mqtt

# Optional: bridge only / never bridge these devices (IEEE or name,
# comma separated).
#Z2S_INCLUDE=
#Z2S_EXCLUDE=

#Z2S_LOG_LEVEL=info

# Time zone of the timestamps in the log (tz database name).
TZ=Europe/Warsaw

# --- Home Assistant ---------------------------------------------------------
# Source of the devices: z2m (zigbee2mqtt, MQTT above) or zha (ZHA in Home
# Assistant, no MQTT; needs the address and token below, docs/zha.md).
#Z2S_SOURCE=z2m
# With MQTT enabled in Supla Cloud, bridged ZigBee devices also reach Home
# Assistant through Supla MQTT discovery, duplicating zigbee2mqtt or ZHA
# devices. The bridge can disable those copies in HA (docs/home-assistant.md).
# Token: HA -> profile (administrator) -> Security -> Long-lived access tokens.
#Z2S_HA_DISABLE_SUPLA_DUPLICATES=true
#Z2S_HA_WEBSOCKET_URL=ws://192.168.1.10:8123/api/websocket
#Z2S_HA_TOKEN=
